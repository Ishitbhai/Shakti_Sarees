<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Shakti_Sarees.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Shakti Saree</title>

    <!-- Google Fonts & Font Awesome Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="mainForm" runat="server">
        <!-- ================= EXACT WIREFRAME HEADER ================= -->
        <header class="ss-header-wrapper">
            <div class="ss-header-inner">
                <!-- TOP ROW -->
                <div class="ss-top-row">
                    <!-- Brand -->
                    <a href="Default.aspx" class="ss-brand-title">Shakti Saree</a>

                    <!-- Pill Search Bar -->
                    <div class="ss-search-pill">
                        <i class="fa-solid fa-magnifying-glass ss-search-ico"></i>
                        <asp:TextBox ID="txtSearch" runat="server" CssClass="ss-search-control" Placeholder="Search for sarees..."></asp:TextBox>
                        <asp:Button ID="btnSearchHidden" runat="server" CssClass="ss-hidden" OnClick="btnSearchHidden_Click" />
                    </div>

                    <!-- Right Controls -->
                    <div class="ss-right-controls">
                        <a href="Orders.aspx" class="ss-track-link">
                            <i class="fa-solid fa-truck ss-truck-ico"></i> Track Order
                        </a>

                        <a href="Cart.aspx" class="ss-bag-wrap">
                            <i class="fa-solid fa-bag-shopping ss-bag-ico"></i>
                            <span class="ss-bag-badge">
                                <asp:Literal ID="litCartCount" runat="server" Text="0"></asp:Literal>
                            </span>
                        </a>

                        <div class="ss-v-divider"></div>

                        <!-- 3 Dynamic Header Variants switched via Site.Master.cs -->
                        <asp:PlaceHolder ID="phGuestActions" runat="server" Visible="true">
                            <a href="Register.aspx" class="ss-btn-pill-outline">Register</a>
                            <a href="Login.aspx" class="ss-btn-pill-outline">Login</a>
                            <a href="Login.aspx" class="ss-avatar-circle">
                                <i class="fa-regular fa-user"></i>
                            </a>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phCustomerActions" runat="server" Visible="false">
                            <a href="Profile.aspx" class="ss-profile-text-link">Profile</a>
                            <a href="Profile.aspx" class="ss-avatar-circle">
                                <i class="fa-regular fa-user"></i>
                            </a>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phAdminActions" runat="server" Visible="false">
                            <a href="Admin/Dashboard.aspx" class="ss-btn-pill-outline ss-btn-admin">Admin Dashboard</a>
                            <a href="Admin/AdminProfile.aspx" class="ss-avatar-circle">
                                <i class="fa-regular fa-user"></i>
                            </a>
                        </asp:PlaceHolder>
                    </div>
                </div>

                <!-- BOTTOM ROW: Navigation menu aligned beneath brand -->
                <div class="ss-bottom-nav">
                    <ul class="ss-menu">
                        <li><a href="Default.aspx">Home</a></li>
                        <li><a href="Categories.aspx">Categories </a></li>
                        <li><a href="About.aspx">About</a></li>
                        <li><a href="Contact.aspx">Contact</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- ================= MAIN BODY CONTENT ================= -->
        <main class="ss-main-viewport">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- ================= EXACT WIREFRAME FOOTER ================= -->
        <footer class="ss-footer-wrapper">
            <div class="ss-footer-inner">
                <!-- Column 1: Brand & Philosophy -->
                <div class="ss-col ss-brand-block">
                    <h3 class="ss-f-brand-title">Shakti Saree</h3>
                    <p class="ss-f-desc">
                        Handcrafted elegance for every occasion. We bring the finest Indian weaves directly to your doorstep with heritage and trust.
                    </p>
                </div>

                <!-- Column 2: Quick Links -->
                <div class="ss-col">
                    <h4 class="ss-f-heading">Quick Links</h4>
                    <ul class="ss-f-links">
                        <li><a href="Default.aspx">Home</a></li>
                        <li><a href="Cart.aspx">Cart</a></li>
                        <li><a href="Orders.aspx">Orders</a></li>
                    </ul>
                </div>

                <!-- Column 3: Categories -->
                <div class="ss-col">
                    <h4 class="ss-f-heading">Categories</h4>
                    <ul class="ss-f-links">
                        <li><a href="Products.aspx?category=Banarasi">Banarasi Silk</a></li>
                        <li><a href="Products.aspx?category=Cotton">Cotton Sarees</a></li>
                        <li><a href="Products.aspx?category=Chiffon">Chiffon & Georgette</a></li>
                        <li><a href="Products.aspx?category=Kanchipuram">Kanchipuram</a></li>
                    </ul>
                </div>

                <!-- Column 4: Contact Info -->
                <div class="ss-col ss-contact-block">
                    <h4 class="ss-f-heading">Contact Info</h4>
                    <div class="ss-contact-row">
                        <i class="fa-solid fa-location-dot ss-c-icon"></i>
                        <span>Tapeshwar Mandir Road,<br />Satta Bazar, Veraval.</span>
                    </div>
                    <div class="ss-contact-row">
                        <i class="fa-solid fa-phone ss-c-icon"></i>
                        <span>+91 84600 65647</span>
                    </div>
                    <div class="ss-contact-row">
                        <i class="fa-regular fa-envelope ss-c-icon"></i>
                        <span>ishitvadhavana@gmail.com</span>
                    </div>
                </div>
            </div>

            <!-- Reddish Subtle Divider Line & Copyright -->
            <div class="ss-footer-divider"></div>
            <div class="ss-footer-copyright">
                <p>&copy; 2026 Shakti Saree. All rights reserved. Designed for Elegance.</p>
            </div>
        </footer>
    </form>
</body>
</html>